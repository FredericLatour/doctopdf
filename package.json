{
  "name": "doctopdf",
  "module": "src/main.ts",
  "type": "module",
  "private": true,
  "version": "1.1.0",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "start": "bun run src/main.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "typecheck": "tsc --noEmit",
    "test:fast": "bun test tests/unit tests/integration",
    "test:e2e": "bun test tests/e2e",
    "test:all": "bun run test:fast && bun run test:e2e",
    "fixtures:generate": "bun run tests/fixtures/generate-fixtures.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/yauzl": "^3.4.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@effect/platform-bun": "4.1.4",
    "docxtemplater": "^3.71.1",
    "effect": "4.1.4",
    "hono": "^4.13.18",
    "markdown-it": "^15.0.3",
    "pdf-lib": "^1.17.1",
    "pizzip": "^3.3.0",
    "playwright-core": "^1.65.0",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  }
}
